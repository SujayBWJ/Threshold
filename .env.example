# Server
PORT=4021

# x402 / Algorand TestNet
# Public receiver address only in committed examples — never put real secrets here.
AVM_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Optional overrides
X402_PRICE="$0.001"
# Only "testnet" is supported in this milestone
X402_NETWORK=testnet

# Client payer (Chunk 3) — NEVER commit real values
# 25-word TestNet mnemonic for the paying account
AVM_MNEMONIC=
# Public address derived from AVM_MNEMONIC (optional convenience)
AVM_PAYER_ADDRESS=

# Receiver setup helper only (opt-in / funding) — NEVER commit real values
AVM_RECEIVER_MNEMONIC=

# API provider wallets (receive-only public addresses)
PROVIDER_CODE_REVIEW_ADDRESS=
PROVIDER_SUMMARIZE_ADDRESS=

# Optional client target
THRESHOLD_URL=http://localhost:4021

# Later milestones:
# LLM_API_KEY=

# Threshold AI / API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
